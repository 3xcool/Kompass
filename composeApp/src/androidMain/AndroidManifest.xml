<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        enableOnBackInvokedCallback turns on the predictive Back gesture. Android 16 turns it on for
        an app that targets API 36, but Android 13 to 15 need this flag. Sample 9 needs it to receive
        the drag.
    -->
    <application
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <!--
            singleTop so a deep link that arrives while the app is running reaches onNewIntent on
            the existing Activity, instead of stacking a second copy of the sample list.
        -->
        <activity
            android:exported="true"
            android:launchMode="singleTop"
            android:name=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Sample 5. Receives myapp://profile/42 and hands the URI to Kompass. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="myapp" />
            </intent-filter>
        </activity>
    </application>

</manifest>